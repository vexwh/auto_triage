# ---------------------------------------------------------------------------
# Artefacts that must never be committed
# ---------------------------------------------------------------------------

# Trained model (~268 MB) — regenerate by running the notebook. See README "Model".
my_support_model/

# Hugging Face Trainer checkpoints (~1.6 GB, mostly optimiser state)
distilbert-base-uncased-finetuned/
checkpoint-*/
runs/
wandb/

# Course submission bundle and presentation media (large / personal)
*.zip
*.mp4
*.pptx
*.doc
*.docx

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
config.local.*

# ---------------------------------------------------------------------------
# GitHub CLI / tooling state written into the working directory
.local/

# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
